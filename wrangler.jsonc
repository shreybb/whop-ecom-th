{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northstar-method-fde",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts"
  // Webhook idempotency requires Supabase (unique insert on webhook_deliveries).
  // Add as Worker secrets before deploying:
  //   whop apps secrets set --secret SUPABASE_URL=...
  //   whop apps secrets set --secret SUPABASE_SERVICE_ROLE_KEY=...
}

# ── Secrets (never commit actual values) ───────────────────────────────────────

# Whop API key — found at whop.com/dashboard/biz_MIbRyC2ejVkuzs/settings/api/
WHOP_API_KEY=

# Webhook signing secret — obtained when registering the webhook endpoint
# Format: ws_...  (see README § Webhook Registration)
WHOP_WEBHOOK_SECRET=

# Optional fallback if the hosted runtime reserves WHOP_API_KEY
NORTHSTAR_API_KEY=

# Supabase — required for atomic webhook idempotency in production
# Create a free project, run the webhook_deliveries SQL from the README,
# then paste the project URL and service-role key (never the anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Public identifiers (safe to commit; already in src/lib/resources.ts) ───────
# These are included here for local .env convenience. They are NOT secrets.

WHOP_COMPANY_ID=biz_MIbRyC2ejVkuzs

# API rehearsal uses sandbox. The hosted storefront, pixel, ads, and $1
# real-card purchase stay on production (leave this blank in Worker secrets).
# CLI: WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1
WHOP_API_ORIGIN=

# Plan IDs — real production IDs from prod_TR58zZsbQFwJu
# Seed fallbacks already use these via src/lib/resources.ts, so you only need
# to set these if you want to override the hardcoded defaults.
WHOP_PLAN_12WK=plan_uCovSzsxHgwz2
WHOP_PLAN_MONTHLY=plan_Svs8MVYQFVs5y
WHOP_PLAN_YEARLY=plan_gvAS7bFXjRnWk

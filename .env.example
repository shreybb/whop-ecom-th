# Whop API
# Found at: whop.com/dashboard/biz_MIbRyC2ejVkuzs/settings/api/
WHOP_API_KEY=

WHOP_COMPANY_ID=biz_MIbRyC2ejVkuzs

# Optional: override API base (e.g. https://sandbox-api.whop.com for sandbox testing)
WHOP_API_ORIGIN=https://api.whop.com

# Webhook signature secret
# Obtained after registering the webhook at:
#   whop.com/dashboard/biz_MIbRyC2ejVkuzs/settings/webhooks/
# Format: whsec_<base64>
WHOP_WEBHOOK_SECRET=

# Upstash Redis — required for atomic webhook idempotency in production
# Create a free database at console.upstash.com
# Copy REST URL and REST token from the database dashboard
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Plan IDs — create plans in the Whop dashboard, then paste their IDs below
# Plans: whop.com/dashboard/biz_MIbRyC2ejVkuzs/products/
WHOP_PLAN_12WK=plan_REPLACE_WITH_REAL_ID
WHOP_PLAN_MONTHLY=plan_REPLACE_WITH_REAL_ID
WHOP_PLAN_YEARLY=plan_REPLACE_WITH_REAL_ID

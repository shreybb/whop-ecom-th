# ── Whop API ────────────────────────────────────────────────────────────────
# Found at: whop.com/dashboard/biz_MIbRyC2ejVkuzs/settings/api/
WHOP_API_KEY=

# Business ID — do not change for Northstar Method
WHOP_COMPANY_ID=biz_MIbRyC2ejVkuzs

# Optional: override API base URL (e.g. https://sandbox-api.whop.com for testing)
WHOP_API_ORIGIN=https://api.whop.com

# ── Webhook signature ────────────────────────────────────────────────────────
# Obtained after creating a webhook at:
#   whop.com/dashboard/biz_MIbRyC2ejVkuzs/settings/webhooks/
# Format: whsec_<base64>
WHOP_WEBHOOK_SECRET=

# ── Plan IDs ─────────────────────────────────────────────────────────────────
# Create plans in the Whop dashboard, then paste their IDs below.
# Plans live at: whop.com/dashboard/biz_MIbRyC2ejVkuzs/products/
WHOP_PLAN_12WK=plan_REPLACE_WITH_REAL_ID
WHOP_PLAN_MONTHLY=plan_REPLACE_WITH_REAL_ID
WHOP_PLAN_YEARLY=plan_REPLACE_WITH_REAL_ID
